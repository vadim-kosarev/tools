# Конфигурация для all_good
# Копировать в .env и заполнить своими значениями

# Hugging Face токен (нужен для pyannote/segmentation-3.0 — VAD-сегментация внутри GigaAM)
HF_TOKEN=

# Путь к FFmpeg (для Windows)
FFMPEG_BIN=C:\Tools\ffmpeg-8.0.1-full_build-shared\bin

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- scan_transcribe.py: значения по умолчанию для CLI-флагов (CLI-аргумент всегда побеждает) ---
scan_transcribe.config.revision=e2e_rnnt
scan_transcribe.config.device=auto
scan_transcribe.config.max-segment-sec=12.0
scan_transcribe.config.min-segment-sec=3.0

# --- cut_phrases.py: значения по умолчанию для CLI-флагов (CLI-аргумент всегда побеждает) ---
# cut_phrases.config.output-dir не задан — по умолчанию all_good/cuts, раскомментировать для своего пути
# cut_phrases.config.output-dir=D:\cuts
cut_phrases.config.padding-ms=300
cut_phrases.config.silence-noise-db=-30
cut_phrases.config.silence-min-sec=0.3
cut_phrases.config.silence-probe-sec=2.0
