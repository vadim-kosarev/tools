# RAG Configuration Example
# Скопируйте в .env и настройте под свои параметры

# === Ollama ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b              # LLM для генерации ответов
OLLAMA_EMBED_MODEL=bge-m3            # Модель эмбеддингов (1024 dim)

# === Knowledge Base ===
KNOWLEDGE_DIR=Z:\ES-Leasing\СОИБ КЦОИ  # Папка с исходными документами

# === ClickHouse ===
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=soib_kcoi_v2
CLICKHOUSE_TABLE=chunks              # Таблица чанков (+ chunks_sections для индекса названий)

# === Retrieval ===
RETRIEVER_TOP_K=10                   # Количество чанков в семантическом поиске

# === Agent (rag_agent.py) ===
AGENT_MAX_ITERATIONS=6               # Максимум раундов вызова инструментов
AGENT_MAX_TOOL_CHARS=12000           # Предел символов результата инструмента для LLM
OLLAMA_TIMEOUT=300                   # Таймаут запроса к Ollama, секунды

# === Logging ===
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR

# === MCP HTTP server ===
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8000
# MCP_HTTP_DEBUG=0                   # 1 — DEBUG-логи модулей kb_tools*