{
  "dashboard": {
    "id": null,
    "uid": "immich-overview",
    "title": "Immich Overview",
    "tags": ["immich"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "refresh": "5m",
    "time": { "from": "now-2y", "to": "now" },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Users",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "aei9ecrbja3nke" },
        "targets": [
          { "expr": "immich_users_total", "legendFormat": "users", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "API up",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "aei9ecrbja3nke" },
        "targets": [
          { "expr": "up{job=\"immich_api\"}", "legendFormat": "immich_api", "refId": "A" }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
            ],
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Microservices up",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "aei9ecrbja3nke" },
        "targets": [
          { "expr": "up{job=\"immich_microservices\"}", "legendFormat": "immich_microservices", "refId": "A" }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
            ],
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "CPU utilization",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "datasource": { "type": "prometheus", "uid": "aei9ecrbja3nke" },
        "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
        "targets": [
          { "expr": "system_cpu_utilization{job=~\"immich_.*\"}", "legendFormat": "{{job}} system", "refId": "A" },
          { "expr": "process_cpu_utilization{job=~\"immich_.*\"}", "legendFormat": "{{job}} process", "refId": "B" }
        ]
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Memory usage (process)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "datasource": { "type": "prometheus", "uid": "aei9ecrbja3nke" },
        "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
        "targets": [
          { "expr": "process_memory_usage{job=~\"immich_.*\"}", "legendFormat": "{{job}}", "refId": "A" }
        ]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Active jobs by queue",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "datasource": { "type": "prometheus", "uid": "aei9ecrbja3nke" },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "targets": [
          { "expr": "{__name__=~\"immich_queues_.*_active\"}", "legendFormat": "{{__name__}}", "refId": "A" }
        ]
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Job success/failure rate (5m)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "datasource": { "type": "prometheus", "uid": "aei9ecrbja3nke" },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "targets": [
          { "expr": "rate({__name__=~\"immich_jobs_.*_success_total\"}[5m])", "legendFormat": "{{__name__}}", "refId": "A" },
          { "expr": "rate({__name__=~\"immich_jobs_.*_failed_total\"}[5m])", "legendFormat": "{{__name__}}", "refId": "B" }
        ]
      },
      {
        "id": 20,
        "type": "row",
        "title": "Library",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 21,
        "type": "stat",
        "title": "Total assets",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 21 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "targets": [
          { "format": "table", "rawSql": "SELECT count(*) FROM asset WHERE \"deletedAt\" IS NULL", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] }
      },
      {
        "id": 22,
        "type": "stat",
        "title": "Photos",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 21 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "targets": [
          { "format": "table", "rawSql": "SELECT count(*) FROM asset WHERE \"deletedAt\" IS NULL AND type='IMAGE'", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] }
      },
      {
        "id": 23,
        "type": "stat",
        "title": "Videos",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 21 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "targets": [
          { "format": "table", "rawSql": "SELECT count(*) FROM asset WHERE \"deletedAt\" IS NULL AND type='VIDEO'", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] }
      },
      {
        "id": 24,
        "type": "stat",
        "title": "People",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 21 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "targets": [
          { "format": "table", "rawSql": "SELECT count(*) FROM person", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] }
      },
      {
        "id": 25,
        "type": "stat",
        "title": "Faces detected",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 21 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "targets": [
          { "format": "table", "rawSql": "SELECT count(*) FROM asset_face", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] }
      },
      {
        "id": 26,
        "type": "stat",
        "title": "Storage used",
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 21 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "targets": [
          { "format": "table", "rawSql": "SELECT sum(\"fileSizeInByte\") FROM asset_exif", "refId": "A" }
        ],
        "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes" }, "overrides": [] }
      },
      {
        "id": 27,
        "type": "timeseries",
        "title": "Asset library growth (cumulative)",
        "gridPos": { "h": 9, "w": 24, "x": 0, "y": 25 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "targets": [
          {
            "format": "time_series",
            "refId": "A",
            "rawSql": "SELECT day::timestamp AS time, SUM(cnt) OVER (ORDER BY day) AS assets FROM (SELECT date_trunc('day', \"createdAt\") AS day, count(*) AS cnt FROM asset WHERE \"deletedAt\" IS NULL GROUP BY 1) sub ORDER BY day"
          }
        ]
      },
      {
        "id": 28,
        "type": "timeseries",
        "title": "People growth (cumulative)",
        "gridPos": { "h": 9, "w": 12, "x": 0, "y": 34 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "targets": [
          {
            "format": "time_series",
            "refId": "A",
            "rawSql": "SELECT day::timestamp AS time, SUM(cnt) OVER (ORDER BY day) AS people FROM (SELECT date_trunc('day', \"createdAt\") AS day, count(*) AS cnt FROM person GROUP BY 1) sub ORDER BY day"
          }
        ]
      },
      {
        "id": 29,
        "type": "timeseries",
        "title": "Storage growth (cumulative)",
        "gridPos": { "h": 9, "w": 12, "x": 12, "y": 34 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
        "targets": [
          {
            "format": "time_series",
            "refId": "A",
            "rawSql": "SELECT day::timestamp AS time, SUM(bytes) OVER (ORDER BY day) AS storage_bytes FROM (SELECT date_trunc('day', a.\"createdAt\") AS day, SUM(e.\"fileSizeInByte\") AS bytes FROM asset a JOIN asset_exif e ON e.\"assetId\" = a.id WHERE a.\"deletedAt\" IS NULL GROUP BY 1) sub ORDER BY day"
          }
        ]
      },
      {
        "id": 30,
        "type": "barchart",
        "title": "Top camera models",
        "gridPos": { "h": 9, "w": 12, "x": 0, "y": 43 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "options": { "xTickLabelRotation": -45 },
        "targets": [
          {
            "format": "table",
            "refId": "A",
            "rawSql": "SELECT make || ' ' || model AS camera, count(*) AS assets FROM asset_exif WHERE make IS NOT NULL AND make != '' GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
          }
        ]
      },
      {
        "id": 31,
        "type": "barchart",
        "title": "Top countries",
        "gridPos": { "h": 9, "w": 12, "x": 12, "y": 43 },
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "dft371muh1m9sd" },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "options": { "xTickLabelRotation": -45 },
        "targets": [
          {
            "format": "table",
            "refId": "A",
            "rawSql": "SELECT country, count(*) AS assets FROM asset_exif WHERE country IS NOT NULL AND country != '' GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
          }
        ]
      }
    ]
  },
  "folderId": 0,
  "overwrite": true
}
