# Хост: starlight (резервный/standby)

# The location where your uploaded files are stored (фото синкаются Resilio Sync, БД — pg_basebackup standby)
UPLOAD_LOCATION=H:/immich/upload

IMMICH_VERSION=release

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=postgres

# Create in Immich UI: User Settings → API Keys
# IMMICH_API_KEY=your_api_key_here

# face-search: API keys аккаунтов, чьи библиотеки объединяются при поиске (через запятую).
# Если не задано - используется одиночный IMMICH_API_KEY (один аккаунт).
FACE_SEARCH_API_KEYS=B8eCfJ7jiPbzjeyqHKy34Tt6URCVuTs9b5Gv8yT9nU,7YJRfG7yxi4i3Kjx1KTlqdFwsxTO6Il7UUCTnkE7Q

# face-search локально на starlight: DB стоит standby-реплики (только чтение) поднимать нельзя
# immich-server/ML тут не поднят - берём с живого brightsky по LAN, пока standby не промоутнут
FACE_SEARCH_IMMICH_URL=http://brightsky:2283
FACE_SEARCH_ML_URL=http://brightsky:3003
